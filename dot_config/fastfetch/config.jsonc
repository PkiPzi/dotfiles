// modules from Kuehnelt/solstice-dots. Their logo is a manga panel in two Catppuccin tones; this is
// Rem (Re:Zero) edited the same way (#1e1e2e / #cdd6f4), drawn as a real image through alacritty-graphics' Sixel.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "~/.config/fastfetch/rem.png",
    "height": 15,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "color": { "keys": "blue", "title": "magenta" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "packages",
    "shell",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
