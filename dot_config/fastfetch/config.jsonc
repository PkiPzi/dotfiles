// modules from Kuehnelt/solstice-dots. Their logo is a manga panel in Catppuccin tones; this is C.C.
// (Code Geass, art by creayus) as line art in two of them, drawn through alacritty-graphics' Sixel.
// fastfetch caches the rendered logo in ~/.cache/fastfetch/images: clear it after changing the image.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "~/.config/fastfetch/cc.png",
    "height": 15,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "color": { "keys": "blue", "title": "magenta" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "packages",
    "shell",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
