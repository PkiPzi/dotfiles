// modules from Kuehnelt/solstice-dots. Their logo is an image, which alacritty can't draw
// (chafa turns the sketch into a bright block), so the distro logo in Catppuccin colours instead.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "endeavouros",
    "color": { "1": "magenta", "2": "red", "3": "blue" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "color": { "keys": "blue", "title": "magenta" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "packages",
    "shell",
    "de",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
