""",
    "GlassMedia.qml": """// the stock media controls on a pill
import QtQuick
import org.kde.kirigami as Kirigami

Item {
    implicitWidth: media.implicitWidth
    implicitHeight: media.implicitHeight + Kirigami.Units.largeSpacing * 2

    GlassPill {
        anchors.fill: parent
        visible: media.visible  // the controls hide themselves when nothing plays
    }
    MediaControls {
        id: media
        anchors.fill: parent
        anchors.margins: Kirigami.Units.largeSpacing
    }
}
""",
}

# (file, stock text, replacement); each stock text must appear exactly once, or the
# lock screen stays stock. Only looks change: the unlock logic is always Plasma's own.
LOCK_PATCHES = [
    ("LockScreenUi.qml", "        Clock {\n            id: clock\n", "        GlassClock {\n            id: clock\n"),
    ("LockScreenUi.qml", "            visible: y > 0 && config.alwaysShowClock\n",
     "            visible: config.alwaysShowClock\n"),
    ("LockScreenUi.qml", "            y: (mainBlock.userList.y + mainStack.y)/2 - height/2\n",
     "            y: mainStack.y + mainStack.height / 2 - height - Kirigami.Units.gridUnit * 2\n"),
    ("LockScreenUi.qml", "            visible: !lockScreenUi.softwareRendering && config.alwaysShowClock\n",
     "            visible: false  // the clock has a pill instead of a shadow\n"),
    ("LockScreenUi.qml", "                showUserList: userList.y + mainStack.y > 0\n",
     "                showUserList: false\n"),
    ("LockScreenUi.qml", '                    source: "MediaControls.qml"\n', '                    source: "GlassMedia.qml"\n'),
    ("MainBlock.qml", "            id: passwordBox\n", """            id: passwordBox
            leftPadding: Kirigami.Units.gridUnit
            // the reveal-password eye sits 1px from the edge, made for Plasma's square frame;
            // inset it so it clears the pill's curve
            _rightActionsRow.anchors.rightMargin: Kirigami.Units.gridUnit * 0.75
            rightPadding: _rightActionsRow.width + Kirigami.Units.gridUnit * 0.75 + Kirigami.Units.smallSpacing
            background: GlassPill {
                implicitHeight: Kirigami.Units.gridUnit * 2.2
                radius: height / 2
                lit: passwordBox.activeFocus
            }
"""),
    ("MainBlock.qml", "            id: loginButton\n", """            id: loginButton
            background: GlassPill {
                radius: height / 2
                lit: loginButton.activeFocus || loginButton.hovered
            }
"""),
]


def lockscreen(styled=True):
    """Build LOCK_PKG from the stock shell: the lock screen files copied and patched, the rest
    symlinked. Rebuilt each time KWin starts, so a Plasma update is picked up (or, if a patch no
    longer applies, the lock screen simply stays stock)."""
    new = LOCK_PKG.with_name(LOCK_SHELL + ".new")
    shutil.rmtree(new, ignore_errors=True)
    (new / "contents/lockscreen").mkdir(parents=True)
    meta = json.loads((STOCK_SHELL / "metadata.json").read_text())
    meta["KPlugin"] = {k: v for k, v in meta["KPlugin"].items() if "[" not in k}
    meta["KPlugin"].update({"Id": LOCK_SHELL, "Name": "Rice lock screen",
                            "Description": "The stock lock screen on glass pills (~/.local/bin/rice)"})
    (new / "metadata.json").write_text(json.dumps(meta, indent=4))
    for entry in (STOCK_SHELL / "contents").iterdir():
        if entry.name != "lockscreen":
            (new / "contents" / entry.name).symlink_to(entry)
    lock = new / "contents/lockscreen"
    stock = STOCK_SHELL / "contents/lockscreen"
    # copies, not symlinks: QML looks up sibling types next to the symlink's target
    for entry in stock.iterdir():
        shutil.copy2(entry, lock / entry.name)

    if styled:
        patched = {}
        for name, old, replacement in LOCK_PATCHES:
            text = patched.get(name) or (stock / name).read_text()
            if text.count(old) != 1:
                print(f"lock screen left stock: {name} changed upstream ({old.strip()!r} not found)")
                break
            patched[name] = text.replace(old, replacement)
        else:
            for name, text in {**patched, **LOCK_QML}.items():
                (lock / name).write_text(text)

    old = LOCK_PKG.with_name(LOCK_SHELL + ".old")
    shutil.rmtree(old, ignore_errors=True)
    if LOCK_PKG.exists():
        LOCK_PKG.rename(old)
    new.rename(LOCK_PKG)
    shutil.rmtree(old, ignore_errors=True)


def lockscreen_on():
    lockscreen()
    dropin = f"""# written by ~/.local/bin/rice: the screen locker uses the rice lock screen
[Service]
Environment=PLASMA_DEFAULT_SHELL={LOCK_SHELL}
ExecStartPre=-%h/.local/bin/rice lockscreen
"""
    if not KWIN_DROPIN.exists() or KWIN_DROPIN.read_text() != dropin:
        KWIN_DROPIN.parent.mkdir(parents=True, exist_ok=True)
        KWIN_DROPIN.write_text(dropin)
        run("systemctl", "--user", "daemon-reload")
        print("the glass lock screen starts with your next login")


def lockscreen_off():
    # without the package the locker falls back to the stock one right away
    shutil.rmtree(LOCK_PKG, ignore_errors=True)
    if KWIN_DROPIN.exists():
        KWIN_DROPIN.unlink()
        run("systemctl", "--user", "daemon-reload")


# a lone Meta is an ordinary global shortcut since Plasma 6.7 (kwinrc's ModifierOnlyShortcuts is gone);
# rice moves it from Plasma's launcher to rofi
META, ALT_F1 = 0x01000022, 0x09000030
ROFI = ["rofi-launcher.desktop", "_launch", "Rofi launcher", "Launch rofi"]
PLASMA_LAUNCHER = ["plasmashell", "activate application launcher", "", ""]


def global_keys(action, change):
    """Rewrite one global shortcut's keys: change(list of keycodes) -> list of keycodes."""
    accel = dbus.Interface(dbus.SessionBus().get_object("org.kde.kglobalaccel", "/kglobalaccel"),
                           "org.kde.KGlobalAccel")
    keys = [int(k[0][0]) for k in accel.shortcutKeys(action) if k[0][0]]
    accel.setForeignShortcutKeys(action, dbus.Array(
        [dbus.Struct([dbus.Array([k, 0, 0, 0], signature="i")]) for k in change(keys)], signature="(ai)"))


def meta_to_rofi(on):
    if on:
        global_keys(PLASMA_LAUNCHER, lambda keys: [k for k in keys if k != META])
        global_keys(ROFI, lambda keys: [META] + [k for k in keys if k != META])
    else:
        global_keys(ROFI, lambda keys: [k for k in keys if k != META])
        global_keys(PLASMA_LAUNCHER, lambda keys: [META] + ([k for k in keys if k != META] or [ALT_F1]))


CLOCK_PX = 14  # the clock text's height on every screen, in logical pixels
CLOCK_PILL_SIDES = 16  # the clock's pill gets more room either side than the others (8)


def clock_points():
    """Plasma's clock turns a custom fontSize (points) into pixels with the screen's physical
    pixel density, so one size looks bigger on the laptop than on the scaled 4K monitor. Give
    each screen the point size that comes out at CLOCK_PX: [{x, y, points}] by screen position."""
    try:
        out = json.loads(run("kscreen-doctor", "-j", capture_output=True, text=True).stdout)["outputs"]
    except (subprocess.CalledProcessError, ValueError, KeyError):
        return []
    sizes = []
    for o in out:
        if not o.get("enabled") or not o.get("sizeMM", {}).get("width"):
            continue
        mode = next(m for m in o["modes"] if m["id"] == o["currentModeId"])
        logical_width = mode["size"]["width"] / o["scale"]
        ppi = logical_width / (o["sizeMM"]["width"] / 25.4)  # what Qt calls Screen.pixelDensity, per inch
        sizes.append({"x": o["pos"]["x"], "y": o["pos"]["y"], "points": round(CLOCK_PX * 72 / ppi)})
    return sizes


def islands():
    """Panel Colorizer settings: no panel background, each group of widgets between two
    spacers becomes one rounded glass pill."""
    g = json.loads(Path(
        "/usr/share/plasma/plasmoids/luisbocanegra.panel.colorizer/contents/ui/presets/Pulse/settings.json"
    ).read_text())["globalSettings"]
    g["panel"]["normal"]["enabled"] = False
    g["nativePanel"] = {"background": {"enabled": True, "opacity": 0, "shadow": False},
                        "floatingDialogs": True, "floatingDialogsAllowOverride": True}
    g["trayWidgets"]["normal"]["enabled"] = False
    w = g["widgets"]["normal"]
    w["enabled"] = True
    w["blurBehind"] = True
    w["backgroundColor"].update({"enabled": True, "sourceType": 0, "custom": GLASS, "alpha": GLASS_ALPHA})
    w["foregroundColor"]["enabled"] = False
    w["radius"] = {"enabled": True, "corner": {c: 14 for c in ("topLeft", "topRight", "bottomRight", "bottomLeft")}}
    w["margin"] = {"enabled": True, "side": {"top": 3, "bottom": 3, "left": 8, "right": 8}}
    w["spacing"] = 6
    w["border"].update({"enabled": True, "customSides": False, "width": 1})
    w["border"]["color"].update({"enabled": True, "sourceType": 0, "custom": GLASS_BORDER, "alpha": GLASS_BORDER_ALPHA})
    w["shadow"]["background"]["enabled"] = False
    return g


def clock_pill():
    """The normal pill with wider sides; Panel Colorizer overrides replace, not merge, so it's whole."""
    pill = islands()["widgets"]["normal"]
    pill["margin"]["side"].update({"left": CLOCK_PILL_SIDES, "right": CLOCK_PILL_SIDES})
    return pill


def panels_js():
    return f"""
var colorizer = {json.dumps(json.dumps(islands()))};
var clockPill = {json.dumps(clock_pill())};
var clock = {json.dumps(CLOCK)};
var clockPoints = {json.dumps(clock_points())};

function clockFor(screen) {{
    var g = screenGeometry(screen), c = JSON.parse(JSON.stringify(clock));
    c.fontSize = 10;
    clockPoints.forEach(function (o) {{ if (o.x == g.x && o.y == g.y) c.fontSize = o.points; }});
    return c;
}}
var kara = {json.dumps(KARA)};
var wallpaper = {json.dumps("file://" + str(WALLPAPER))};

function configure(widget, group, values) {{
    widget.currentConfigGroup = group;
    for (var k in values) widget.writeConfig(k, values[k]);
}}

panels().forEach(function (p) {{ p.remove(); }});

// one floating top bar per screen; spacers split it into three islands
for (var s = 0; s < screenCount; s++) {{
    var bar = new Panel("org.kde.panel");
    bar.screen = s;
    bar.location = "top";
    bar.height = 38;
    bar.floating = true;
    configure(bar.addWidget("org.dhruv8sh.kara"), ["General"], kara);
    bar.addWidget("org.kde.plasma.panelspacer");
    var clockWidget = bar.addWidget("org.kde.plasma.digitalclock");
    configure(clockWidget, ["Appearance"], clockFor(s));
    bar.addWidget("org.kde.plasma.panelspacer");
    // a paused title that keeps scrolling redraws (and re-blurs) the bar every frame
    configure(bar.addWidget("plasmusic-toolbar"), ["General"], {{ pauseTextScrollingWhileMediaIsNotPlaying: true }});
    bar.addWidget("org.kde.plasma.systemtray");
    configure(bar.addWidget("luisbocanegra.panel.colorizer"), ["General"], {{
        globalSettings: colorizer,
        islandsEnabled: true,
        islandSeparatorWidget: "org.kde.plasma.panelspacer",
        hideWidget: true,
        configurationOverrides: JSON.stringify({{
            overrides: {{ clock: {{ normal: clockPill, disabledFallback: true }} }},
            associations: [{{ id: clockWidget.id, name: "org.kde.plasma.digitalclock", presets: ["clock"] }}],
        }}),
    }});
}}

// full wallpaper, no frame
desktops().forEach(function (d) {{
    d.wallpaperPlugin = "org.kde.image";
    configure(d, ["Wallpaper", "org.kde.image", "General"], {{ Image: wallpaper, FillMode: 2 }});
    d.widgets("luisbocanegra.desktop.wallpaper.effects").forEach(function (w) {{ w.remove(); }});
}});
"""


def snapshot():
    if SNAPSHOT.exists():
        shutil.rmtree(SNAPSHOT)
    SNAPSHOT.mkdir(parents=True)
    for f in KDE_FILES:
        if (CONFIG / f).exists():
            shutil.copy2(CONFIG / f, SNAPSHOT / f)


def solstice():
    if current() != "solstice":
        snapshot()

    # rofi on a Meta tap goes through a kglobalaccel service entry
    apps = HOME / ".local/share/applications"
    apps.mkdir(parents=True, exist_ok=True)
    (apps / "rofi-launcher.desktop").write_text(ROFI_DESKTOP)
    accel = dbus.Interface(dbus.SessionBus().get_object("org.kde.kglobalaccel", "/kglobalaccel"),
                           "org.kde.KGlobalAccel")
    accel.doRegister(ROFI)
    meta_to_rofi(True)
    kdelete("kwinrc", ["ModifierOnlyShortcuts"], "Meta")  # the pre-6.7 way

    run("plasma-apply-colorscheme", "CatppuccinMochaRed", check=False, stdout=subprocess.DEVNULL)
    run("plasma-apply-desktoptheme", "Amethyst.Haze", check=False, stdout=subprocess.DEVNULL)
    run("/usr/lib/plasma-changeicons", "yet-another-monochrome-icon-set")
    for key, font in [("font", UI_FONT), ("menuFont", UI_FONT), ("toolBarFont", UI_FONT),
                      ("smallestReadableFont", SMALL_FONT), ("fixed", MONO_FONT)]:
        kwrite("kdeglobals", ["General"], key, font)
    kwrite("kdeglobals", ["WM"], "activeFont", UI_FONT)
    notify_kde(1)

    for group, values in KWIN.items():
        for key, value in values.items():
            kwrite("kwinrc", [group], key, value)
    for rule, values in RULES.items():
        for key, value in values.items():
            kwrite("kwinrulesrc", [rule], key, value)
    for rule in OLD_RULES:
        drop_rule(rule)
    existing = [r for r in kread("kwinrulesrc", ["General"], "rules").split(",")
                if r and r not in RULES and r not in OLD_RULES]
    rules = list(RULES) + existing
    kwrite("kwinrulesrc", ["General"], "rules", ",".join(rules))
    kwrite("kwinrulesrc", ["General"], "count", len(rules))
    reconfigure_kwin(effects_on=EFFECTS_ON, effects_off=EFFECTS_OFF)

    lock = ["Greeter", "Wallpaper", "org.kde.image", "General"]
    kwrite("kscreenlockerrc", lock, "Image", f"file://{WALLPAPER}")
    kwrite("kscreenlockerrc", lock, "PreviewImage", f"file://{WALLPAPER}")

    plasma_script(panels_js())
    lockscreen_on()
    sddm("catppuccin-mocha-red")
    login_screen(True)
    set_links("solstice")
    print("solstice on. `rice plain` goes back. Reopen nvim/alacritty windows to pick it up fully.")


def plain():
    if SNAPSHOT.exists():
        run("systemctl", "--user", "stop", "plasma-plasmashell")
        for f in KDE_FILES:
            if (SNAPSHOT / f).exists():
                shutil.copy2(SNAPSHOT / f, CONFIG / f)
            else:  # did not exist before solstice
                (CONFIG / f).unlink(missing_ok=True)
        run("systemctl", "--user", "start", "plasma-plasmashell")
        time.sleep(2)
    else:
        print("no snapshot to restore, resetting the look only (panels stay as they are)")
        for group, values in KWIN.items():
            for key in values:
                kdelete("kwinrc", [group], key)
        rules = [r for r in kread("kwinrulesrc", ["General"], "rules").split(",") if r and r not in RULES]
        kwrite("kwinrulesrc", ["General"], "rules", ",".join(rules))
        kwrite("kwinrulesrc", ["General"], "count", len(rules))

    # the files are back; tell running apps and KWin
    scheme = kread("kdeglobals", ["General"], "ColorScheme", "BreezeDark")
    run("plasma-apply-colorscheme", scheme, check=False, stdout=subprocess.DEVNULL)
    run("plasma-apply-desktoptheme", kread("plasmarc", ["Theme"], "name", "default"),
        check=False, stdout=subprocess.DEVNULL)
    run("/usr/lib/plasma-changeicons", kread("kdeglobals", ["Icons"], "Theme", "breeze-dark"))
    notify_kde(1)
    reconfigure_kwin(effects_on=[e for e in EFFECTS_OFF
                                 if kread("kwinrc", ["Plugins"], f"{e}Enabled", "true") == "true"],
                     effects_off=EFFECTS_ON)
    # windows keep the opacity the hover script last gave them
    dbus.SessionBus().get_object("org.kde.KWin", "/Scripting").unloadScript(
        HOVER_SCRIPT, dbus_interface="org.kde.kwin.Scripting")
    kwin_script("workspace.stackingOrder.forEach(w => { if (w.normalWindow || w.dialog) w.opacity = 1; });")
    lockscreen_off()
    meta_to_rofi(False)
    sddm(None)
    login_screen(False)
    set_links("plain")
    print("plain look restored. Reopen nvim/alacritty windows to pick it up fully.")


def current():
    return STATE.read_text().strip() if STATE.exists() else "plain"


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "solstice":
        solstice()
    elif arg == "plain":
        plain()
    elif arg == "lockscreen":  # run by KWin's ExecStartPre, see lockscreen_on()
        if current() == "solstice":
            lockscreen()
    elif arg in ("", "status"):
        print(f"current: {current()}\n\n{__doc__.strip()}")
    else:
        sys.exit(f"unknown rice: {arg}\n\n{__doc__.strip()}")


if __name__ == "__main__":
    main()
