def run(*cmd, check=True, **kw):
    return subprocess.run(cmd, check=check, **kw)


def kwrite(file, groups, key, value):
    group_args = [a for g in groups for a in ("--group", g)]
    run("kwriteconfig6", "--file", file, *group_args, "--key", key, str(value))


def kdelete(file, groups, key):
    group_args = [a for g in groups for a in ("--group", g)]
    run("kwriteconfig6", "--file", file, *group_args, "--key", key, "--delete")


def kread(file, groups, key, default=""):
    group_args = [a for g in groups for a in ("--group", g)]
    out = run("kreadconfig6", "--file", file, *group_args, "--key", key, "--default", default,
              capture_output=True, text=True).stdout.strip()
    return out


def drop_rule(rule):
    for key in ["Description", "wmclass", "wmclassmatch", "types", "opacityactive", "opacityactiverule",
                "opacityinactive", "opacityinactiverule"]:
        kdelete("kwinrulesrc", [rule], key)


def kwin_script(js):
    """Run a one-off KWin script."""
    bus = dbus.SessionBus()
    scripting = dbus.Interface(bus.get_object("org.kde.KWin", "/Scripting"), "org.kde.kwin.Scripting")
    with tempfile.NamedTemporaryFile("w", suffix=".js") as f:
        f.write(js)
        f.flush()
        scripting.unloadScript("rice-oneshot")
        sid = scripting.loadScript(f.name, "rice-oneshot", signature="ss")
        bus.get_object("org.kde.KWin", f"/Scripting/Script{sid}").run(dbus_interface="org.kde.kwin.Script")
        time.sleep(0.5)
        scripting.unloadScript("rice-oneshot")


def plasma_script(js):
    shell = dbus.SessionBus().get_object("org.kde.plasmashell", "/PlasmaShell")
    return shell.evaluateScript(js, dbus_interface="org.kde.PlasmaShell")


def notify_kde(change):
    # KGlobalSettings::ChangeType: 0 palette, 1 font, 2 style, 4 icons
    run("dbus-send", "--session", "--type=signal", "/KGlobalSettings",
        "org.kde.KGlobalSettings.notifyChange", f"int32:{change}", "int32:0")


def reconfigure_kwin(effects_on=(), effects_off=()):
    bus = dbus.SessionBus()
    bus.get_object("org.kde.KWin", "/KWin").reconfigure(dbus_interface="org.kde.KWin")
    effects = dbus.Interface(bus.get_object("org.kde.KWin", "/Effects"), "org.kde.kwin.Effects")
    for e in effects_off:
        effects.unloadEffect(e)
    for e in effects_on:
        effects.loadEffect(e)
        effects.reconfigureEffect(e)  # an already-loaded effect keeps its old settings otherwise


def set_links(name):
    for link, target in [
        (CONFIG / "alacritty/rice.toml", f"rices/{name}.toml"),
        (CONFIG / "starship.toml", f"starship/{name}.toml"),
    ]:
        link.unlink(missing_ok=True)
        link.symlink_to(target)
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(name + "\n")


def sddm(theme):
    """Login screen theme; needs sudo. None removes the override."""
    try:
        if theme:
            content = f"[Theme]\nCurrent={theme}\n"
            run("sudo", "mkdir", "-p", str(SDDM_CONF.parent))
            run("sudo", "tee", str(SDDM_CONF), input=content, text=True, stdout=subprocess.DEVNULL)
        elif SDDM_CONF.exists():
            run("sudo", "rm", "-f", str(SDDM_CONF))
    except subprocess.CalledProcessError:
        print("login screen theme skipped (needs sudo)")


def login_screen(on):
    """Plasma Login Manager wallpaper; needs sudo."""
    group_args = [a for g in LOGIN_IMAGE_GROUPS for a in ("--group", g)]
    try:
        if on:
            run("sudo", "install", "-Dm644", str(WALLPAPER), str(LOGIN_WALLPAPER))
            run("sudo", "kwriteconfig6", "--file", str(LOGIN_CONF), *group_args,
                "--key", "Image", f"file://{LOGIN_WALLPAPER}")
            # kwriteconfig6 as root makes it 600, and the greeter runs as its own user
            run("sudo", "chmod", "644", str(LOGIN_CONF))
        else:
            if LOGIN_CONF.exists():
                run("sudo", "kwriteconfig6", "--file", str(LOGIN_CONF), *group_args, "--key", "Image", "--delete")
            run("sudo", "rm", "-rf", str(LOGIN_WALLPAPER.parent))
    except subprocess.CalledProcessError:
        print("login screen wallpaper skipped (needs sudo)")


def argb(hex_color, alpha):
    return f"#{round(alpha * 255):02x}{hex_color[1:]}"


LOCK_QML = {
    "GlassPill.qml": f"""// the top bar's glass islands (~/.local/bin/rice)
import QtQuick

Rectangle {{
    property bool lit: false  // keyboard focus: red ring, like the focused window outline
    color: "{argb(GLASS, GLASS_ALPHA)}"
    radius: 14
    border.width: lit ? 2 : 1
    border.color: lit ? "{RED_HEX}" : "{argb(GLASS_BORDER, GLASS_BORDER_ALPHA)}"
    Behavior on border.color {{ ColorAnimation {{ duration: 150 }} }}
}}
""",
